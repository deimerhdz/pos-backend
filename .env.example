# --- PostgreSQL (usados por docker-compose para el servicio 'postgres') ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=pos_db

# --- Conexiones de la app ---
# En docker-compose el host es el nombre del servicio ('postgres' / 'redis'),
# no 'localhost'. Para desarrollo fuera de Docker usa localhost.
DATABASE_URL=postgresql+psycopg://admin:cambia-esto@postgres:5432/pos_db
REDIS_URL=redis://redis:6379/0

# --- Seguridad / JWT ---
JWT_SECRET=
JWT_ALGORITHM=HS256
# Minutos. Access 24h, refresh 7 días (debe ser mayor que ACCESS_TOKEN_EXPIRY).
ACCESS_TOKEN_EXPIRY=1440
REFRESH_TOKEN_EXPIRY_MINUTES=10080
PROJECT_NAME=pos
# Ambiente: prod | dev (afecta la URL de login del correo de bienvenida)
ENVIRONMENT=dev

# --- Email (servicio HTTP) ---
# URL base del servicio; el envío hace POST a EMAIL_API_URL + /api/email/send
EMAIL_API_URL=
MAIL_FROM_NAME=Mi app
MAIL_FROM=onboarding@resend.dev

# --- Super admin sembrado en el primer arranque ---
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@admin.com
SUPER_ADMIN_PASSWORD=Admin1234!

# --- Cloudflare R2 (storage de imágenes) ---
# R2_ENDPOINT_URL: https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL: dominio público del bucket (r2.dev o dominio custom conectado).
#   Sigue sirviendo los comprobantes del comensal (carpeta 'comprobantes') y la
#   reversión de la migración de spec 080 — NO cambiarlo por assets.skeilopos.com.
# ASSETS_BASE_URL: dominio personalizado de R2 con el que se sirven las imágenes de
#   producto, logo y método de pago (spec 080). En base de datos vive solo la key;
#   esta base se antepone al responder. Un cambio futuro de dominio se hace solo aquí.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
ASSETS_BASE_URL=https://assets.skeilopos.com
R2_PRESIGN_EXPIRE_SECONDS=300

# --- Sesión de mesa / QR (todos opcionales, con default en config.py) ---
# Secreto dedicado para firmar los tokens de QR/sesión. Si falta, usa JWT_SECRET.
QR_TOKEN_SECRET=
# Ventana deslizante del comensal y tope absoluto de su token.
SESSION_TTL_MINUTES=240
SESSION_ABS_MAX_MINUTES=1440
# Cierre automático de sesiones de mesa abandonadas.
TABLE_SESSION_MAX_HOURS=6
# Inactividad tras la que se libera una mesa sin ningún pedido (escaneo y abandono).
EMPTY_SESSION_TTL_MINUTES=30
SESSION_SWEEP_INTERVAL_MINUTES=15

# --- Rate limiting de rutas públicas del QR ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP=60
RATE_LIMIT_PER_TABLE=120
RATE_LIMIT_WINDOW_SECONDS=60
#sentry
SENTRY_DSN=
# Clave HMAC dedicada para el log de auditoría de órdenes (spec 074) — nunca
# reutilizar JWT_SECRET aquí. Opcional en dev/test; si falta, el log de
# auditoría falla explícitamente al intentar hashear un dato sensible.
AUDIT_HASH_SECRET=

# --- Notificaciones: canal push del navegador (spec 077) ---
# Par de claves VAPID (RFC 8292) de esta aplicación — generarlas una sola vez
# por despliegue (p. ej. `vapid --gen`, incluido con la dependencia `py-vapid`
# de `pywebpush`) y reutilizarlas: son la identidad de la app ante los push
# services, no una credencial por tenant. Si faltan, el canal push queda
# inactivo (fail-open, ver research.md §5) sin afectar al resto de la app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=